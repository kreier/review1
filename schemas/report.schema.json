{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelReviewReport",
  "description": "Schema for individual AI model technical review reports",
  "type": "object",
  "required": [
    "model",
    "model_id",
    "target_repo",
    "review_date",
    "scores"
  ],
  "properties": {
    "model": {
      "type": "string",
      "description": "Readable name of the AI model (e.g., Claude 3.7 Sonnet, GPT-4o, Gemini 3.8 Flash)"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Kebab-case unique identifier for the model"
    },
    "target_repo": {
      "type": "string",
      "description": "Name or identifier of the repository being reviewed"
    },
    "target_commit": {
      "type": "string",
      "description": "Optional Git commit SHA of the target repository at time of review"
    },
    "review_date": {
      "type": "string",
      "description": "ISO format date (YYYY-MM-DD) of the review"
    },
    "scores": {
      "type": "object",
      "properties": {
        "overall": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "architecture": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "code_quality": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "security": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "documentation": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "description": "Executive summary of the repository assessment"
    },
    "key_strengths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Noted technical strengths"
    },
    "key_weaknesses": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Noted technical weaknesses or limitations"
    },
    "security_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "file"],
        "properties": {
          "id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "status": {
            "type": "string",
            "enum": ["verified", "probable", "unverified"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "affected_function": { "type": "string" },
          "description": { "type": "string" },
          "evidence": { "type": "string" },
          "impact": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    }
  }
}
