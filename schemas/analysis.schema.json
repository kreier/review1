{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TargetMetricsSchema",
  "description": "Schema for deterministic target repository metrics produced by analyze-target.py",
  "type": "object",
  "required": [
    "analyzer_version",
    "analyzed_at",
    "target_path",
    "total_files",
    "total_dirs",
    "total_lines",
    "code_lines",
    "blank_lines",
    "languages"
  ],
  "properties": {
    "analyzer_version": { "type": "string" },
    "analyzed_at": { "type": "string" },
    "target_path": { "type": "string" },
    "git_info": {
      "type": "object",
      "properties": {
        "commit_hash": { "type": "string" },
        "short_hash": { "type": "string" },
        "branch": { "type": "string" },
        "commit_date": { "type": "string" },
        "author": { "type": "string" },
        "commit_message": { "type": "string" },
        "remote_url": { "type": "string" }
      }
    },
    "total_files": { "type": "integer", "minimum": 0 },
    "total_dirs": { "type": "integer", "minimum": 0 },
    "total_lines": { "type": "integer", "minimum": 0 },
    "code_lines": { "type": "integer", "minimum": 0 },
    "comment_lines": { "type": "integer", "minimum": 0 },
    "blank_lines": { "type": "integer", "minimum": 0 },
    "doc_lines": { "type": "integer", "minimum": 0 },
    "data_lines": { "type": "integer", "minimum": 0 },
    "languages": { "type": "object" },
    "languages_sorted": { "type": "array" },
    "key_files": {
      "type": "object",
      "properties": {
        "configs": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "array", "items": { "type": "string" } },
        "ci_cd": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } }
      }
    },
    "security_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "type": { "type": "string" },
          "severity": { "type": "string" },
          "category": { "type": "string" },
          "match": { "type": "string" },
          "confidence": { "type": "number" },
          "scanner": { "type": "string" }
        }
      }
    },
    "structure": { "type": "array" }
  }
}
